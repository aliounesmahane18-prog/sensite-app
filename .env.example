# Copier ce fichier en .env.local et remplir les valeurs
# (Supabase Dashboard → Settings → API)

# URL du projet Supabase — publique
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "anon / public" — publique, protégée par les règles RLS.
# IMPORTANT (Vercel) : ne PAS cocher « Sensitive » pour les deux variables
# NEXT_PUBLIC_* ci-dessus. Une variable « Sensitive » n'est pas lisible pendant
# le build, donc Next.js ne peut pas l'injecter dans le bundle navigateur :
# le client Supabase se retrouve sans clé et la page reste blanche
# (« supabaseKey is required »).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique de l'app, utilisée pour construire les liens de catalogue
NEXT_PUBLIC_APP_URL=https://sensite-app-1vlp.vercel.app

# Clé "service_role" — SECRÈTE, uniquement côté serveur (routes app/api/**).
# Celle-ci peut rester marquée « Sensitive » dans Vercel : elle est lue à
# l'exécution par le serveur, jamais par le navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
